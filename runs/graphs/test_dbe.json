 "edges": [
  {
   "prereq": "access_control",
   "dependent": "database_security",
   "reason": "Database security relies on access control to restrict who can access data."
  },
  {
   "prereq": "access_control",
   "dependent": "discretionary_access_control_dac",
   "reason": "DAC is a specific model of access control, so general access control must be understood first."
  },
  {
   "prereq": "access_control",
   "dependent": "mandatory_access_control_mac",
   "reason": "MAC is a specific access control model enforcing access via security classifications."
  },
  {
   "prereq": "access_control",
   "dependent": "role_based_access_control_rbac",
   "reason": "RBAC is a specific model of access control, so general access control must be understood first."
  },
  {
   "prereq": "attribute",
   "dependent": "entity_relationship_model",
   "reason": "ER model describes properties as attributes so attribute must be understood first"
  },
  {
   "prereq": "attribute",
   "dependent": "tuple",
   "reason": "A tuple is an ordered list of values where each position corresponds to an attribute."
  },
  {
   "prereq": "authentication",
   "dependent": "access_control",
   "reason": "Access control authorization decisions require identities verified by authentication."
  },
  {
   "prereq": "candidate_key",
   "dependent": "key_attribute",
   "reason": "Key attributes are defined as attributes that belong to any candidate key."
  },
  {
   "prereq": "candidate_key",
   "dependent": "normalisation",
   "reason": "Normal forms are defined in terms of candidate keys and prime attributes."
  },
  {
   "prereq": "candidate_key",
   "dependent": "primary_key",
   "reason": "A primary key is a candidate key chosen as the main identifier."
  },
  {
   "prereq": "candidate_key",
   "dependent": "prime_attribute",
   "reason": "A prime attribute is defined as an attribute that is part of any candidate key."
  },
  {
   "prereq": "cardinality",
   "dependent": "cardinality_ratio",
   "reason": "Cardinality ratios specify maximum participation counts, requiring the general cardinality concept."
  },
  {
   "prereq": "cardinality_ratio",
   "dependent": "many_to_many",
   "reason": "Many-to-many is one of the cardinality ratio types constraining relationship participation."
  },
  {
   "prereq": "cardinality_ratio",
   "dependent": "one_to_many",
   "reason": "One-To-Many is a specific type of cardinality ratio."
  },
  {
   "prereq": "cardinality_ratio",
   "dependent": "one_to_one",
   "reason": "One-to-one is one instance of a cardinality ratio."
  },
  {
   "prereq": "cartesian_product",
   "dependent": "join",
   "reason": "Join is defined as a selection over the cartesian product of two relations."
  },
  {
   "prereq": "closure",
   "dependent": "minimal_cover",
   "reason": "Closure tests are used to detect extraneous attributes and redundant dependencies when minimizing."
  },
  {
   "prereq": "concurrent_transaction",
   "dependent": "isolation",
   "reason": "Isolation governs interference between concurrently executing transactions."
  },
  {
   "prereq": "concurrent_transaction",
   "dependent": "the_dirty_read_problem",
   "reason": "Dirty read only occurs with interleaved execution of multiple concurrent transactions."
  },
  {
   "prereq": "concurrent_transaction",
   "dependent": "the_lost_update_problem",
   "reason": "Lost update only occurs when transactions execute concurrently with interleaved reads and writes."
  },
  {
   "prereq": "concurrent_transaction",
   "dependent": "the_unrepeatable_read_problem",
   "reason": "The anomaly only occurs due to interleaved execution of concurrent transactions."
  },
  {
   "prereq": "count",
   "dependent": "group_by",
   "reason": "GROUP BY is used to partition rows for per-group aggregation like COUNT"
  },
  {
   "prereq": "create_table",
   "dependent": "alter_table",
   "reason": "ALTER TABLE modifies tables first defined by CREATE TABLE"
  },
  {
   "prereq": "create_table",
   "dependent": "drop_table",
   "reason": "Must understand what a table is as created by CREATE TABLE before it can be dropped."
  },
  {
   "prereq": "data_model",
   "dependent": "relational_data_model",
   "reason": "The relational model is a specific type of data model, so the general concept of a data model must be understood first."
  },
  {
   "prereq": "data_model",
   "dependent": "schema",
   "reason": "A schema is a description of database structure expressed using the constructs of a data model."
  },
  {
   "prereq": "data_type",
   "dependent": "create_table",
   "reason": "Each column in CREATE TABLE must be declared with a specific data type"
  },
  {
   "prereq": "data_type",
   "dependent": "ddl",
   "reason": "DDL table definitions require specifying data types for attributes."
  },
  {
   "prereq": "database_security",
   "dependent": "trojan_horse_attack",
   "reason": "Provides the threat model and security goals that Trojan Horse attacks violate"
  },
  {
   "prereq": "ddl",
   "dependent": "alter_table",
   "reason": "ALTER TABLE is a DDL statement for defining database structure"
  },
  {
   "prereq": "ddl",
   "dependent": "drop_table",
   "reason": "DROP TABLE is a DDL operation that modifies database structure, not data."
  },
  {
   "prereq": "difference",
   "dependent": "except",
   "reason": "EXCEPT is the SQL implementation of the relational algebra Difference operation."
  },
  {
   "prereq": "discretionary_access_control_dac",
   "dependent": "grant",
   "reason": "GRANT is SQL's implementation of discretionary access control."
  },
  {
   "prereq": "discretionary_access_control_dac",
   "dependent": "trojan_horse_attack",
   "reason": "Trojan Horses exploit discretionarily granted privileges passed to malicious code"
  },
  {
   "prereq": "dml",
   "dependent": "delete",
   "reason": "DELETE is a DML statement for modifying stored data"
  },
  {
   "prereq": "dml",
   "dependent": "insert",
   "reason": "INSERT is a DML statement for manipulating data so must understand DML."
  },
  {
   "prereq": "domain",
   "dependent": "tuple",
   "reason": "Each value in a tuple must be drawn from the domain of its attribute."
  },
  {
   "prereq": "enhanced_entity_relationship",
   "dependent": "superclass",
   "reason": "Superclass is defined within EER as the parent in superclass/subclass relationships."
  },
  {
   "prereq": "entity",
   "dependent": "relationship",
   "reason": "A relationship is defined as an association among entities, so Entity must be understood first."
  },
  {
   "prereq": "entity_relationship_model",
   "dependent": "enhanced_entity_relationship",
   "reason": "EER directly extends the ER model with specialization, generalization, and inheritance."
  },
  {
   "prereq": "entity_relationship_model",
   "dependent": "participation_constraint",
   "reason": "It provides the modeling framework where participation constraints are expressed."
  },
  {
   "prereq": "equality",
   "dependent": "natural_join",
   "reason": "Natural join combines tuples with equal values on common attributes"
  },
  {
   "prereq": "equivalent",
   "dependent": "minimal_cover",
   "reason": "A minimal cover is defined as an equivalent set with no redundancy, so equivalence of FD sets is required."
  },
  {
   "prereq": "functional_dependency",
   "dependent": "closure",
   "reason": "Closure is defined as the set of all functional dependencies implied by a given set of functional dependencies"
  },
  {
